m_file_list(d)}"
> =C2=A0do_fetch[file-checksums] +=3D " ${@get_lic_checksum_file_list(d)}"
> =C2=A0do_fetch[prefuncs] +=3D "fetcher_hashes_dummyfunc"
> =C2=A0do_fetch[network] =3D "1"
> +do_fetch[vardeps] +=3D "PREMIRRORS MIRRORS"
