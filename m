-+	      case module:
-+#if !INTDIV0_RAISES_SIGFPE
-+		if (rightarg =3D=3D 0)
-+		  raise (SIGFPE);
-+#endif
-+		return leftarg % rightarg;
-+	      case plus:
-+		return leftarg + rightarg;
-+	      case minus:
-+		return leftarg - rightarg;
-+	      case less_than:
-+		return leftarg < rightarg;
-+	      case greater_than:
-+		return leftarg > rightarg;
-+	      case less_or_equal:
-+		return leftarg <=3D rightarg;
-+	      case greater_or_equal:
-+		return leftarg >=3D rightarg;
-+	      case equal:
-+		return leftarg =3D=3D rightarg;
-+	      case not_equal:
