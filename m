-+      }
-+
-+  if (empty)
-+    {
-+      for (l in libs)
-+	if (inherit[l] == lib)
-+	  inherit[l] = inherit[lib];
-+    }
-+  else if (inherit[lib])
-+    printf("} %s;\n", inherit[lib]);
-+  else
-+    printf ("\n  local:\n\t*;\n};\n");
-+}
