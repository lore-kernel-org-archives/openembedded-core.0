+++ b/meta/recipes-multimedia/alsa/alsa-utils_1.0.27.2.bb
@@ -9,7 +9,7 @@ DEPENDS = "alsa-lib ncurses libsamplerate0 udev"
 
 PACKAGECONFIG ??= "udev"
 PACKAGECONFIG[udev] = "--with-udev-rules-dir=`pkg-config --variable=udevdir udev`/rules.d,,udev"
