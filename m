+-  /* Get the message from the catalog.  We always use set number 1.
+-     The message ID is computed by the function `msg_to_cat_id'
+-     which works on the table generated by `po-to-tbl'.  */
+-  msgid =3D msg_to_cat_id (msg);
+-  if (msgid =3D=3D -1)
