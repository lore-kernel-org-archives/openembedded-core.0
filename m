+++ b/meta/recipes-bsp/u-boot/u-boot.inc
@@ -113,7 +113,9 @@ do_install () {
         unset i
     else
         install -D -m 644 ${B}/${UBOOT_BINARY} ${D}/boot/${UBOOT_IMAGE}
