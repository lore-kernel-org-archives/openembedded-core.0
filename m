-+  libs[$1] = 1;
-+  thislib = $1;
-+  next;
-+}
-+
-+$1 == "}" {
-+  thislib = "";
-+  next;
-+}
-+
-+{
-+  ver[$1] = thislib;
-+  next;
-+}
-+
-+END {
-+  if (!sawsymbol)
-+    {
-+      print "No symbols seen -- broken or mis-installed nm?" | "cat 1>&2";
-+      exit 1;
-+    }
-+  for (l in libs)
-+    output(l);
-+}
-+
-+function output(lib) {
-+  if (done[lib])
-+    return;
-+  done[lib] = 1;
-+  if (inherit[lib])
-+    output(inherit[lib]);
-+
-+  empty=1
-+  for (sym in ver)
