index b910b5a..ba41e8f 100644
--- a/meta/recipes-bsp/grub/grub_1.99.bb
+++ b/meta/recipes-bsp/grub/grub_1.99.bb
@@ -41,4 +41,4 @@ do_install_append () {
 
 FILES_${PN}-doc = "${datadir}"
 FILES_${PN} = "/usr /etc"
-
