+ #define TMP_TAIL_O	dlltmp (&tmp_tail_o_buf, "%st.o")
+-#define TMP_STUB	dlltmp (&tmp_stub_buf, "%ss")
++#define TMP_STUB	dlltmp (&tmp_stub_buf, "%ssnnnnn.o")
+ 
+ /* This bit of assembly does jmp * ....  */
