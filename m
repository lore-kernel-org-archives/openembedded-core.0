+-#endif
+-  asymbol *  ptrs[NSECS + 4 + EXTRA + 1];
+-  flagword   applicable;
+-  char *     outname = xmalloc (strlen (TMP_STUB) + 10);
+-  int        oidx = 0;
+-
+-
+-  sprintf (outname, "%s%05d.o", TMP_STUB, i);
