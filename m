-+sub DELETE { delete $SIG{ &_check } }
-+sub CLEAR  { &_exist; delete @SIG{ &POSIX::SIGRTMIN .. &POSIX::SIGRTMAX } }
-+sub SCALAR { &_croak; $_sigrtn + 1 }
