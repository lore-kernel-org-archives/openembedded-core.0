+#!/bin/sh
+# Copyright (C) 2011 O.S. Systems Software LTDA.
+# Licensed on MIT
+
+# Adds support to dynamic debugging of initramfs using bootparam in
+# following format:
+#   shell                 : starts a shell before and after each module
+#   shell=3Dbefore:<module> : starts a shell before <module> is loaded and=
 run
+#   shell=3Dafter:<module>  : starts a shell after <module> is loaded and =
run
+#
+#   shell-debug                 : run set -x as soon as possible
+#   shell-debug=3Dbefore:<module> : run set -x before <module> is loaded a=
nd run
+#   shell-debug=3Dafter:<module>  : run set -x after <module> is loaded an=
d run
+
+DEBUG_SHELL=3D"false"
+
+debug_hook_handler() {
+       status=3D$1
+       module=3D$2
+
+       if [ -n "$bootparam_shell" ] && [ "$bootparam_shell" !=3D "true" ];=
 then
+               shell_wanted_status=3D`expr $bootparam_shell : '\(.*\):.*'`
+               shell_wanted_module=3D`expr $bootparam_shell : '.*:\(.*\)'`
+
+               if [ "$shell_wanted_status" =3D "before" ]; then
+                       shell_wanted_status=3Dpre
+               else
+                       shell_wanted_status=3Dpost
+               fi
+       fi
+
+       if [ "$bootparam_shell" =3D "true" ] ||
+               ( [ "$status" =3D "$shell_wanted_status" ] &&
+                       [ "$module" =3D "$shell_wanted_module" ] ); then
+               if [ "$status" =3D "pre" ]; then
+                       status_msg=3D"before"
+               else
+                       status_msg=3D"after"
+               fi
+
+               msg "Starting shell $status_msg $module..."
+               sh
+       fi
+
+       if [ -n "$bootparam_shell_debug" ] && [ "$bootparam_shell_debug" !=
=3D "true" ]; then
+               shell_debug_wanted_status=3D`expr $bootparam_shell_debug : =
'\(.*\):.*'`
+               shell_debug_wanted_module=3D`expr $bootparam_shell_debug : =
'.*:\(.*\)'`
+
+               if [ "$shell_debug_wanted_status" =3D "before" ]; then
+                       shell_debug_wanted_status=3Dpre
+               else
+                       shell_debug_wanted_status=3Dpost
+               fi
+       fi
+
+       if [ "$bootparam_shell_debug" =3D "true" ] ||
+               ( [ "$status" =3D "$shell_debug_wanted_status" ] &&
+                       [ "$module" =3D "$shell_debug_wanted_module" ] ); t=
hen
+               if [ "$DEBUG_SHELL" =3D "true" ]; then
+                       return 0
+               fi
+
+               if [ "$status" =3D "pre" ]; then
+                       status_msg=3D"before"
+               else
+                       status_msg=3D"after"
+               fi
+
+               msg "Starting shell debugging $status_msg $module..."
+               DEBUG_SHELL=3D"true"
+               set -x
+       fi
+}
+
+debug_enabled() {
+       return 0
+}
+
+debug_run() {
+       add_module_pre_hook "debug_hook_handler"
+       add_module_post_hook "debug_hook_handler"
+}
