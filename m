> link_path)
>        0215:}
>        0216:
>        0217:ROOTFS_POSTPROCESS_COMMAND:prepend =3D
> "${@'cve_check_write_rootfs_manifest; ' if
> d.getVar('CVE_CHECK_CREATE_MANIFEST') =3D=3D '1' else ''}"
