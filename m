+
+udev_enabled() {
+       if [ ! -e /sbin/udevd ]; then
+               debug "/sbin/udev doesn't exist"
+               return 1
+       fi
+
+       return 0
+}
+
+udev_run() {
+       mkdir -p /run
+
+       udevd --daemon > /dev/null
+       udevadm trigger --action=3Dadd
+       udevadm settle
+
+       killall udevd 2>/dev/null
+}
