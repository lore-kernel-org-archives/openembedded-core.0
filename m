--=item strcat
--
--strcat() is C-specific, use C<.=> instead, see L<perlop>.
--
--=item strchr
--
--strchr() is C-specific, see L<perlfunc/index> instead.
--
--=item strcmp
--
--strcmp() is C-specific, use C<eq> or C<cmp> instead, see L<perlop>.
