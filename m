+-{
+-  int cnt;
+-
+-  for (cnt =3D 0; cnt < _msg_tbl_length; ++cnt)
+-    if (strcmp (msg, _msg_tbl[cnt]._msg) =3D=3D 0)
+-      return _msg_tbl[cnt]._msg_number;
