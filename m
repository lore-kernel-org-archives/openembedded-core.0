>>>> +++ b/meta/recipes-devtools/python-numpy/python-numpy_1.16.3.bb
>>>> @@ -4,3 +4,7 @@ require python-numpy.inc
>>>>   RDEPENDS_${PN}_class-target_append = " \
>>>>       ${PYTHON_PN}-subprocess \
>>>>   "
>>>> +
>>>> +do_install_append(){
>>>> +        rm ${D}/${bindir}/f2py
>>>> +}
