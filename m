+ 
+-  iname_lab_pp = ptrs + oidx;
++  asymbol **iname_lab_pp = ptrs + oidx;
+   ptrs[oidx++] = iname_lab;
+ 
+   ptrs[oidx] = 0;
+@@ -3089,29 +3078,26 @@ gen_lib_file (int delay)
+ 
+   if (dontdeltemps < 2)
+     {
+-      char *name;
+-      size_t stub_len = strlen (TMP_STUB);
