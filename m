index 1d4e744250a..3d6a88314b8 100644
--- a/meta/lib/oeqa/selftest/cases/reproducible.py
+++ b/meta/lib/oeqa/selftest/cases/reproducible.py
@@ -34,7 +34,6 @@ exclude_packages = [
 	'go-runtime',
 	'go_',
 	'go-',
